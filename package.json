{
  "name": "vibe-remote-buddy-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "release": "tauri build --no-bundle --features custom-protocol && node scripts/package.mjs",
    "release:archive": "tauri build --no-bundle --features custom-protocol && node scripts/package.mjs --archive"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.9.7",
    "typescript": "~5.8.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}

; Vibe Remote Buddy Windows installer (NSIS 3, MUI2).
; Per-user install into %LOCALAPPDATA%\Programs, HKCU registry only,
; so normal users never hit UAC. Input is a verified portable package;
; SRCDIR / OUTFILE / ICONFILE / version defines are generated by
; scripts/make-installer.mjs into build/installer/defines.nsh.

Unicode true
ManifestDPIAware true
RequestExecutionLevel user
AllowRootDirInstall false
SetCompressor /SOLID lzma

!include "MUI2.nsh"
!include "FileFunc.nsh"

!define APP_NAME "Vibe Remote Buddy"
!define APP_EXE "Vibe Remote Buddy.exe"
!define ARP_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_NAME}"

!include "..\build\installer\defines.nsh"

Name "${APP_NAME}"
OutFile "${OUTFILE}"
BrandingText "${APP_NAME} ${DISPLAY_VERSION}"

VIProductVersion "${VERSION4}"
VIAddVersionKey "ProductName" "${APP_NAME}"
VIAddVersionKey "ProductVersion" "${DISPLAY_VERSION}"
VIAddVersionKey "FileDescription" "${APP_NAME} Installer"
VIAddVersionKey "FileVersion" "${VERSION4}"
VIAddVersionKey "LegalCopyright" "${PUBLISHER}"

InstallDir "$LOCALAPPDATA\Programs\${APP_NAME}"
InstallDirRegKey HKCU "Software\${APP_NAME}" "InstallDir"

!define MUI_ICON "${ICONFILE}"
!define MUI_UNICON "${ICONFILE}"
!define MUI_ABORTWARNING
!define MUI_LANGDLL_REGISTRY_ROOT HKCU
!define MUI_LANGDLL_REGISTRY_KEY "Software\${APP_NAME}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "Installer Language"
!define MUI_FINISHPAGE_RUN "$INSTDIR\${APP_EXE}"
!define MUI_FINISHPAGE_RUN_TEXT "$(RunApp)"

!insertmacro MUI_PAGE_LICENSE "${SRCDIR}\LICENSE"
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

; English first: it is also the fallback for silent installs.
!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "SimpChinese"
!insertmacro MUI_LANGUAGE "TradChinese"
!insertmacro MUI_LANGUAGE "Japanese"
!insertmacro MUI_LANGUAGE "Korean"
!insertmacro MUI_LANGUAGE "German"
!insertmacro MUI_LANGUAGE "French"
!insertmacro MUI_LANGUAGE "Spanish"
!insertmacro MUI_LANGUAGE "Italian"
!insertmacro MUI_LANGUAGE "Russian"
!insertmacro MUI_LANGUAGE "PortugueseBR"

LangString SecDesktop ${LANG_ENGLISH} "Desktop shortcut"
LangString DescCore ${LANG_ENGLISH} "The application and all bundled resources."
LangString DescDesktop ${LANG_ENGLISH} "Add a shortcut to the desktop."
LangString MsgCloseApp ${LANG_ENGLISH} "${APP_NAME} is still running. Close it and click Retry."
LangString RunApp ${LANG_ENGLISH} "Run ${APP_NAME}"

